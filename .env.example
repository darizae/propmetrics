DATA_DIR=./data
DE_BRW_SOURCES_JSON=./sources/de_boris_brw_sources.json

SERVER_URL=http://127.0.0.1:8000

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# UI CORS (dev only)
CORS_ORIGINS=*

# Rate limits (disabled when RATE_QPS=0)
RATE_QPS=0
RATE_BURST=10

# LLM front
export OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
export OPENAI_PROJECT=proj_xxxxxxxxxxxxxxxx      # matches the Project you copied
# optional if org-scoped routing is enforced for your account:
export OPENAI_ORG=org_xxxxxxxxxxxxxxxx
# optional for non-default endpoints (leave empty for OpenAI public API):
export OPENAI_API_BASE=
OPENAI_MODEL=gpt-3.5-turbo-0125
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=300
LLM_MAX_PROMPT_CHARS=1000
LLM_MOCK=0
